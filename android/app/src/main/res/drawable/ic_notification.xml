<!--
  Status-bar notification icon: the FeedWell mark (small square plus two nested
  corner brackets), traced from assets/adaptive-icon.png and scaled to fill the
  24dp viewport.

  Android builds notification small icons from the ALPHA CHANNEL ONLY — the
  system picks the colour and masks everything else away — so this has to be a
  flat single-colour silhouette. A full-colour logo is not possible here; the
  white "background" comes from the notification accent colour, which the system
  fills the surrounding circle with (see notification_accent in colors.xml).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
  <!-- outer bracket: top bar -->
  <path
      android:fillColor="#FFFFFFFF"
      android:pathData="M2,2 H21.9 V6.25 H2 Z" />
  <!-- outer bracket: right descender -->
  <path
      android:fillColor="#FFFFFFFF"
      android:pathData="M17.75,2 H21.9 V22 H17.75 Z" />
  <!-- inner bracket: bar -->
  <path
      android:fillColor="#FFFFFFFF"
      android:pathData="M2,10 H14 V14.1 H2 Z" />
  <!-- inner bracket: descender -->
  <path
      android:fillColor="#FFFFFFFF"
      android:pathData="M9.9,10 H14 V22 H9.9 Z" />
  <!-- the dot -->
  <path
      android:fillColor="#FFFFFFFF"
      android:pathData="M2,17.85 H6.15 V22 H2 Z" />
</vector>
